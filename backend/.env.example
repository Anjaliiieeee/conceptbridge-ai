# ConceptBridge AI - Backend Environment Configuration

PROJECT_NAME="ConceptBridge AI"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"

# Security & Authentication
# Generate in production using: openssl rand -hex 32
SECRET_KEY="replace-with-your-own-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Use SQLite for simple local zero-config development or PostgreSQL for production/docker:
DATABASE_URL="sqlite:///./conceptbridge.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/conceptbridge"

# OpenAI API Configuration
# If left empty, ConceptBridge AI automatically runs in its intelligent educational Mock Engine mode
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'
